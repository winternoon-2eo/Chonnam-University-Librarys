# ==========================================
# VibeLib 환경 변수 설정 가이드 (.env.local)
# ==========================================

# 1. Google Gemini API 키 (필수 권장: 완전 무료, 분당 15회/일 1500회 무료)
# 발급처: https://aistudio.google.com/app/apikey (구글 로그인 후 10초 발급)
GEMINI_API_KEY=

# 2. 알라딘 Open API TTBKey (선택: 실제 알라딘 목차/평점 연동)
# 발급처: https://www.aladin.co.kr/openapi/ (알라딘 로그인 후 무료 신청)
ALADIN_TTB_KEY=

# 3. Supabase 설정 (선택: 영구 DB 캐싱 및 푸시 구독 저장)
# 미설정 시에도 인메모리 캐시로 100% 정상 작동합니다.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
